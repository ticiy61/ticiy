[{"characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","charName":"陆延","poolId":"standard","sceneId":"","owner":"user","dailyDay":"2026-10-12","cardKey":"echo|42e461eb-9415-4abe-8c47-ecfdaccd5458|1791456923297","category":"echo","rarity":"N","title":"陆延……有点烦……","echo":{"ts":1791440757667,"messages":[{"id":1791447918336,"sender":"them","ts":1791432901779,"kind":"text","text":"小气，发张照片延哥又不会把你吃了"},{"id":1791447918337,"sender":"them","ts":1791432904490,"kind":"text","text":"行吧，既然小祖宗都这么说了"},{"id":1791447918338,"sender":"them","ts":1791432913543,"kind":"text","text":"那下班我去接你，到时候本尊必须让我看个够"},{"id":1791447918339,"sender":"them","ts":1791432917281,"kind":"text","text":"还得连本带利把这顿饭的‘精神损失费’补回来"},{"id":1791447918340,"sender":"them","ts":1791432922269,"kind":"text","text":"外卖到了赶紧趁热吃，多吃点"},{"id":1791447918341,"sender":"them","ts":1791432926712,"kind":"text","text":"要是晚上让我发现你饿瘦了，抱起来手感不好，看我怎么收拾你"},{"id":1791447918342,"sender":"them","ts":1791432927742,"kind":"sticker","stickerRef":"","stickerUrl":"https://i.postimg.cc/j5Bpgkt5/1773231325453-IMG-3243.jpg","text":""},{"id":1791456923297,"sender":"me","ts":1791440757667,"kind":"text","text":"陆延……有点烦……"}]},"materialKey":"msg:1791456923297","resonance":0,"userId":"uid_1790097193431_hsqqph93y","createdAt":1791760296179,"updatedAt":1791760296179,"_id":1},{"characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","charName":"陆延","poolId":"standard","sceneId":"","owner":"user","cardKey":"echo|42e461eb-9415-4abe-8c47-ecfdaccd5458|1791402893343","category":"echo","rarity":"N","title":"嗯？哪有……","echo":{"ts":1791365515020,"messages":[{"id":1791402893337,"sender":"them","ts":1791362145810,"kind":"text","text":"至于江驰……他那张脸黑得都能滴出墨了。"},{"id":1791402893338,"sender":"them","ts":1791362149506,"kind":"text","text":"刚才还拿笔敲桌子警告我，原话是：‘陆延，你的脑子要是没和引擎一起烧坏，就赶紧放下手机。’"},{"id":1791402893339,"sender":"them","ts":1791362154457,"kind":"text","text":"听听，这说的是人话吗？！"},{"id":1791402893340,"sender":"them","ts":1791362158949,"kind":"text","text":"你延哥都被欺负成这样了，光嘴上说一句好惨可不行啊"},{"id":1791402893341,"sender":"them","ts":1791362159789,"kind":"sticker","stickerRef":"","stickerUrl":"https://iili.io/CDNUYiP.gif","text":""},{"id":1791402893342,"sender":"me","ts":1791365492819,"kind":"text","text":"嗯？哪有……"},{"id":1791402893343,"sender":"me","ts":1791365515020,"kind":"text","text":"那你想要什么，嗯？"},{"id":1791402893345,"sender":"them","ts":1791365573602,"kind":"text","text":"行啊，学会反撩了是吧？"}]},"materialKey":"msg:1791402893343","resonance":0,"userId":"uid_1790097193431_hsqqph93y","createdAt":1791760329402,"updatedAt":1791760329402,"_id":2},{"characterId":"8cbc2728-b42e-4fbe-b33f-cd2f3e7cf153","charName":"陆泽","poolId":"standard","sceneId":"","owner":"user","cardKey":"shot|8cbc2728-b42e-4fbe-b33f-cd2f3e7cf153|shot:post:1791381454325","category":"shot","rarity":"N","title":"这个季度的财报勉强过关。顺手替某人压下了几篇不知死活的通稿，如果他以为这就是绝对的自由，未免太天真了。玩够了就尽早滚回来上班，我的耐心有限。","shot":{"kind":"moment","ts":1791381211193,"text":"这个季度的财报勉强过关。顺手替某人压下了几篇不知死活的通稿，如果他以为这就是绝对的自由，未免太天真了。玩够了就尽早滚回来上班，我的耐心有限。","title":"","board":"","images":[{"ref":588}],"location":"","likes":4,"comments":24},"materialKey":"shot:post:1791381454325","resonance":0,"userId":"uid_1790097193431_hsqqph93y","createdAt":1791760329410,"updatedAt":1791760329410,"_id":3}]