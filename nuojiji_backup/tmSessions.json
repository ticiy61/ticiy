[{"userId":"uid_1790097193431_hsqqph93y","characterId":"4102444800000","name":"2026/9/24","type":"this-moment","createdAt":1790230802889,"lastActiveAt":1790230802889,"_id":1},{"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","name":"在你家楼下车里等你","type":"this-moment","scenarioOutline":"在你家楼下车里等你","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"前面不知道哪两个不长眼的追尾了，硬生生把两条车道堵成了一条"},{"role":"char","text":"你洗漱完了吗？乖乖在家里坐着等我，别下楼，外面热"},{"role":"char","text":""},{"role":"char","text":"饿不饿？要不要我先给你点个小蛋糕什么的垫垫肚子？"},{"role":"user","text":"没事没事，我还好"},{"role":"user","text":"就是看你这么长时间没到问一下"},{"role":"user","text":"不着急，你注意安全～"},{"role":"char","text":"你越这么说我越着急"},{"role":"char","text":"恨不得现在弃车跑过去找你"},{"role":"char","text":"前面交警来了，估计马上就能通"},{"role":"char","text":"你乖乖在家吹空调，别在窗口看，今天外面三十多度呢，别热着了"},{"role":"char","text":""},{"role":"user","text":"好～"},{"role":"char","text":"[行程邀約]"},{"role":"user","text":"💌 答应了邀约（陆延）：睡前视频连麦"},{"role":"user","text":"到哪里啦？"},{"role":"char","text":"刚把车停好！就在你家楼下！"},{"role":"char","text":"这破路堵死我了，等急了吧宝宝，是不是饿坏了？"},{"role":"char","text":"快下来，车里空调给你开到最舒服的温度了，我还顺路买了冰镇的草莓汁，先喝一口我们马上杀去吃粥！"},{"role":"char","text":""}]},"createdAt":1791004069290,"lastActiveAt":1791004608949,"_id":3,"completed":true,"completedAt":1791014781108},{"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","name":"2026/10/3","type":"this-moment","createdAt":1791014781120,"lastActiveAt":1791014781120,"dateLabel":"2026/10/3","_id":4},{"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","name":"提着早餐站在你家门外输入密码","type":"this-moment","scenarioOutline":"提着早餐站在你家门外输入密码","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":""},{"role":"user","text":"密码0562"},{"role":"user","text":"你先在客厅坐一下，我收拾一下……"},{"role":"char","text":"收到，密码记住了。"},{"role":"char","text":"以后这门我可就随便进了啊。"},{"role":"char","text":"你慢慢收拾，不着急。"},{"role":"char","text":"不过……"},{"role":"char","text":"我要是忍不住去卧室抓你，可不怪我啊。"},{"role":"char","text":""},{"role":"char","text":""},{"role":"user","text":"陆延，你先拍张自拍我看一下……"},{"role":"char","text":"怎么？"},{"role":"char","text":"我都站你家客厅了，还要看照片？"},{"role":"char","text":"活的男朋友就在门外，你隔着门让我自拍？"},{"role":"char","text":"行，满足你。"},{"role":"char","text":"[發送了一張圖片]"},{"role":"char","text":"看够了吗？"},{"role":"char","text":"看够了我就进卧室抓人了啊。"},{"role":"char","text":"我可是真饿了，想吃早餐，更想吃你。"},{"role":"char","text":""}]},"createdAt":1791082244653,"lastActiveAt":1791082588489,"_id":5,"completed":true,"completedAt":1791097944595},{"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","name":"2026/10/4","type":"this-moment","createdAt":1791097944603,"lastActiveAt":1791097944603,"dateLabel":"2026/10/4","_id":6},{"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","name":"站在门外手里提着蛋糕","type":"this-moment","scenarioOutline":"站在门外手里提着蛋糕","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"我到店里了，刚拿到最后两个草莓蛋糕！"},{"role":"char","text":"再晚一步就被前面那小孩买走了，哥直接凭借大长腿优势抢先扫码。"},{"role":"char","text":"等着，这就给你送过去。"},{"role":"char","text":""},{"role":"char","text":"门密码还是0562吧？没背着我改吧？"},{"role":"user","text":"没有没有"},{"role":"user","text":"哈哈哈哈"},{"role":"user","text":"小孩哥要哭了吧"},{"role":"char","text":"他哭不哭我管不着"},{"role":"char","text":"哥只管我家小祖宗有没有蛋糕吃。"},{"role":"char","text":"那小胖墩刚才瞪我一眼，气呼呼地拉着他妈走了。"},{"role":"char","text":"不过没改密码就行，我快到了。"},{"role":"char","text":"你刚才说的那个‘诚意’，我可是当真了啊。"},{"role":"char","text":"别一会见着我又往后躲。"},{"role":"char","text":""},{"role":"user","text":"嗯？你这表情不对劲……"},{"role":"char","text":"现在才发现不对劲？晚了小祖宗。"},{"role":"char","text":"你延哥可是冒着雨一路给你护送蛋糕过来的，收点‘跑腿费’不过分吧？"},{"role":"char","text":"我到门口了，快开门。"},{"role":"char","text":""}]},"createdAt":1791179251917,"lastActiveAt":1791181420507,"_id":7,"completed":false}]