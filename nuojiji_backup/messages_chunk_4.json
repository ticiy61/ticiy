K/1773237357319-dafa6eab0adf171493622e4bd1726983.jpg","stickerMeaning":"得逞","sender":"them","time":"21:29","timestamp":1791206997228,"roundId":"round_1791206961154_0e6xy5tdf","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":1033},{"id":1791348863339,"text":"嗯？不是……","sender":"me","time":"21:31","timestamp":1791207061712,"replyTo":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":1034},{"id":1791348863340,"text":"你就这么走了他们不会找你嘛……","sender":"me","time":"21:31","timestamp":1791207086848,"replyTo":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":1035},{"id":1791348863342,"text":"哈哈哈哈小祖宗，你慌什么？","rawContent":"哈哈哈哈小祖宗，你慌什么？","isHtml":false,"sticker":null,"sender":"them","time":"21:31","timestamp":1791207117426,"roundId":"round_1791207087536_pm245ypsn","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":1036},{"id":1791348863343,"text":"找呗，腿长在我身上，我想走谁拦得住。","rawContent":"找呗，腿长在我身上，我想走谁拦得住。","isHtml":false,"sticker":null,"sender":"them","time":"21:32","timestamp":1791207123085,"roundId":"round_1791207087536_pm245ypsn","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":1037},{"id":1791348863344,"text":"再说了，跟陪我家宝宝比起来，这破局算老几啊。","rawContent":"再说了，跟陪我家宝宝比起来，这破局算老几啊。","isHtml":false,"sticker":null,"sender":"them","time":"21:32","timestamp":1791207129362,"roundId":"round_1791207087536_pm245ypsn","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":1038},{"id":1791348863345,"text":"他们要是敢有意见，我就说我家小祖宗急着见我，谁敢拦？","rawContent":"他们要是敢有意见，我就说我家小祖宗急着见我，谁敢拦？","isHtml":false,"sticker":null,"sender":"them","time":"21:32","timest