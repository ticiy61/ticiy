l,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5266},{"id":"local_alarm_1792472029427_2026-10-31T13:20","text":"宝宝醒醒啦，该起来拿全勤奖了","rawContent":"宝宝醒醒啦，该起来拿全勤奖了","sender":"them","timestamp":1793424000000,"time":"13:20","type":"text","fromLocalAlarm":true,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5268},{"id":1793428287265,"text":"陆延……","sender":"me","time":"14:31","timestamp":1793428300933,"replyTo":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5269},{"id":1793428287267,"text":"我在呢","rawContent":"我在呢","isHtml":false,"sticker":null,"sender":"them","time":"14:32","timestamp":1793428325185,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5270},{"id":1793428287268,"text":"怎么了乖宝？刚睡醒？","rawContent":"怎么了乖宝？刚睡醒？","isHtml":false,"sticker":null,"sender":"them","time":"14:32","timestamp":1793428329563,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5271},{"id":1793428287269,"text":"叫得这么软，是不是想老公了？","rawContent":"叫得这么软，是不是想老公了？","isHtml":false,"sticker":null,"sender":"them","time":"14:32","timestamp":1793428333791,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5272},{"id":1793428287270,"text":"我刚在赛道这边盯着他们挂南瓜，苏柚非要往我车顶上粘个塑料蜘蛛，吵得我头疼。","rawContent":"我刚在赛道这边盯着他们挂南瓜，苏柚非要往我车顶上粘个塑料蜘蛛，吵得我头疼。","isHtml":false,"sticker":null,"sender":"them","time":"14:32","timestamp":1793428341901,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5273},{"id":1793428287271,"text":"结果你这一声，直接把我魂都叫飞了。","rawContent":"结果你这一声，直接把我魂都叫飞了。","isHtml":false,"sticker":null,"sender":"them","time":"14:32","timestamp":1793428347119,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5274},{"id":1793428287272,"text":"","rawContent":"","isHtml":false,"sticker":"https://iili.io/CDNi0gI.gif","stickerMeaning":"贴贴","sender":"them","time":"14:32","timestamp":1793428348102,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5275},{"id":1793428287273,"text":"你要是睡醒了就慢慢换身衣服，我三点半有个漂移表演，一结束马上就回去接你，好不好？","rawContent":"你要是睡醒了就慢慢换身衣服，我三点半有个漂移表演，一结束马上就回去接你，好不好？","isHtml":false,"sticker":null,"sender":"them","time":"14:32","timestamp":1793428356227,"roundId":"round_1793428301257_lkyhnf4c0","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5276},{"id":1793428287274,"text":"那你什么时候能回来啊？","sender":"me","time":"14:33","timestamp":1793428384576,"replyTo":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5277},{"id":1793428287275,"sticker":"https://i.postimg.cc/rFqkv35p/1773238121060-IMG-3263.jpg","text":"表情包：趴桌子","sender":"me","time":"14:33","timestamp":1793428395400,"replyTo":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5278},{"id":1793428287277,"text":"发这种眼巴巴的表情包，犯规了啊小祖宗。","rawContent":"发这种眼巴巴的表情包，犯规了啊小祖宗。","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429054836,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5279},{"id":1793428287278,"text":"你再这么盯着我看，我真要连方向盘都不要，直接跑回去抱你了。","rawContent":"你再这么盯着我看，我真要连方向盘都不要，直接跑回去抱你了。","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429061357,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5280},{"id":1793428287279,"text":"","rawContent":"","isHtml":false,"sticker":"https://i.postimg.cc/DfHG6QGY/1773238883557-IMG-3296.jpg","stickerMeaning":"揉脸","sender":"them","time":"14:44","timestamp":1793429062436,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5281},{"id":1793428287280,"text":"我三点半下场，跑完大概四点左右。","rawContent":"我三点半下场，跑完大概四点左右。","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429068898,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5282},{"id":1793428287281,"text":"刚才苏柚已经催我去备场了，贺准那傻逼又在对面轰油门挑衅，我得先去赛道上教教他怎么做人。","rawContent":"刚才苏柚已经催我去备场了，贺准那傻逼又在对面轰油门挑衅，我得先去赛道上教教他怎么做人。","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429078273,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5283},{"id":1793428287282,"text":"你在家乖乖的，无聊的话去一楼茶几上拿点零食吃，或者去挑挑今晚万圣节想穿什么衣服。","rawContent":"你在家乖乖的，无聊的话去一楼茶几上拿点零食吃，或者去挑挑今晚万圣节想穿什么衣服。","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429082809,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5284},{"id":1793428287283,"text":"等我跑完这场，连衣服都不换，直接飞车回去接你，嗯？","rawContent":"等我跑完这场，连衣服都不换，直接飞车回去接你，嗯？","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429091485,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5285},{"id":1793428287284,"text":"先亲一下，老公去戴头盔了。","rawContent":"先亲一下，老公去戴头盔了。","isHtml":false,"sticker":null,"sender":"them","time":"14:44","timestamp":1793429094309,"roundId":"round_1793428396317_g7m166kye","generatedMode":false,"translation":null,"userId":"uid_1790097193431_hsqqph93y","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","_id":5286}]