7997,"userId":"uid_1790097193431_hsqqph93y","startDateKey":"2026-10-06","days":1,"items":[{"id":"inc_1791132597993_0","tier":1,"category":"weather","valence":"neutral","requires":{"start":840,"end":1050,"busyLevel":["busy"],"locationKind":"outdoor","weather":["rain","storm"]},"weight":25,"headline":"雨天赛道打滑","narration":"阵雨突然变大，赛道积水严重。陆延在过弯时车辆轻微打滑，但他凭借极强的核心力量和肌肉记忆迅速救车，完美漂移过弯。","effect":{"busyLevel":"busy","titleOverride":"雨战紧急救车","note":"极限操作，有惊无险"},"aftermath":"安排维修团队检查底盘和轮胎磨损。","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791132597993_1","tier":2,"category":"social","valence":"bad","requires":{"start":840,"end":1080,"busyLevel":["free","light","busy"],"locationKind":"work","weather":[]},"weight":30,"headline":"贺准带人挑衅","narration":"贺准带着几个跟班来到俱乐部，对陆延的雨天训练冷嘲热讽。两人在VIP休息区发生口角，气氛一度非常紧张。","effect":{"busyLevel":"light","titleOverride":"处理死对头挑衅","note":"看着贺准就烦"},"aftermath":"圈内传出两人即将私下约战的消息。","scene":"贺准带着几个跟班大摇大摆地走进俱乐部VIP区，看着外面的雨天赛道冷嘲热讽：“陆二少这破天气还练车，是怕下个月的比赛输得太难看？”陆延擦了擦头发上的水珠，桃花眼微微眯起，冷笑了一声：“总比某些只敢在晴天开碰碰车的废物强。”气氛瞬间降至冰点。","choices":[{"label":"赛道上见真章","outcome":"陆延直接把头盔扔给贺准，两人在雨天赛道飙了一场。贺准因为技术不济差点滑出赛道，灰溜溜地走了。","aftermath":"陆延心情大好，晚上胃口大开。","nextDay":null},{"label":"直接轰人","outcome":"陆延懒得理会，直接叫保安把贺准一行人“请”了出去。贺准在门口骂骂咧咧，十分难堪。","aftermath":"贺准在圈子里放狠话要给陆延好看。","nextDay":null},{"label":"江驰出面调停","outcome":"江驰刚好路过，用极其官方且无懈可击的商业辞令把贺准堵得哑口无言，贺准觉得无趣便离开了。","aftermath":"陆延私下嘲笑江驰像个教导主任。","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791132597993_2","tier":1,"category":"luck","valence":"good","requires":{"start":540,"end":780,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":25,"headline":"绝版潮玩到货","narration":"之前托朋友在海外高价收的一款绝版草莓熊潮玩终于清关送达。陆延第一时间拆箱检查，确认完美无瑕后，美滋滋地拍了照。","effect":{"busyLevel":"free","titleOverride":"拆箱绝版潮玩","note":"准备拿去献宝"},"aftermath":"潮玩被精心打包，准备送出。","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791132597993_3","tier":2,"category":"family","valence":"neutral","requires":{"start":720,"end":960,"busyLevel":["free","light"],"locationKind":"work","weather":[]},"weight":20,"headline":"陆泽突击俱乐部","narration":"陆泽突然造访俱乐部，西装革履地出现在轰鸣的赛车场里。他带来了一份文件，并提醒陆延明晚的家庭聚餐必须出席。","effect":{"busyLevel":"light","titleOverride":"应付亲哥查岗","note":"完美对照组又来念经"},"aftermath":"被迫将明晚的家庭聚餐提上日程。","scene":"黑色迈巴赫停在俱乐部外，一身高定西装的陆泽推门而入，与周围的轰鸣声和重金属音乐格格不入。他径直走到吧台前，将一份文件推到陆延面前：“妈让你明晚回家吃饭，别再拿车队训练当借口。”陆延转着手里的打火机，连眼皮都没抬一下。","choices":[{"label":"敷衍答应","outcome":"陆延不耐烦地把文件扒拉到一边，随口应承下来，催促陆泽赶紧离开他的地盘。","aftermath":"明晚不得不回老宅面对全家。","nextDay":{"title":"回老宅挨训","busyLevel":"light","span":"evening"}},{"label":"针锋相对","outcome":"陆延冷嘲热讽了几句陆泽的“完美做派”，明确表示自己没空。两兄弟不欢而散。","aftermath":"沈曼打电话来一顿数落。","nextDay":null}],"tellUser":"no","used":false}],"lastRollKey":null,"lastTickVts":1791210773287,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"true"},{"userId":"uid_1790097193431_hsqqph93y","key":"customHolidays","value":{}},{"userId":"uid_1790097193431_hsqqph93y","key":"enabledCountries","value":["CN"]},{"userId":"uid_1790097193431_hsqqph93y","key":"events","value":[{"id":1791004174759,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"看看我的小祖宗睡了没","date":"2026-10-04","startTime":"23:00","endTime":"23:59","icon":"📱","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098006,"title":"接小祖宗吃晚饭","location":"私房菜馆","note":"带上昨天排队买的限量草莓蛋糕","date":"2026-10-06","startTime":"18:00","endTime":"20:30","icon":"🍓","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgC