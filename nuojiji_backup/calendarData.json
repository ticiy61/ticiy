47-ecfdaccd5458","value":""},{"userId":"__global__","key":"gen_template_user_uid_1790097193431_hsqqph93y","value":""},{"userId":"__global__","key":"incident_pool_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":{"generatedAt":1791256922281,"userId":"uid_1790097193431_hsqqph93y","startDateKey":"2026-10-07","days":1,"items":[{"id":"inc_1791256922281_0","tier":2,"category":"social","valence":"neutral","requires":{"start":660,"end":960,"busyLevel":["free","light","busy"],"locationKind":"work","weather":[]},"weight":30,"headline":"贺准带人踩场子","narration":"贺准趁着假期最后一天，带了几个富二代朋友来到陆延的超跑俱乐部。他故意在VIP区大声挑剔赛道维护情况，试图激怒工作人员并逼陆延下场赛车。","effect":{"busyLevel":"busy","titleOverride":"处理贺准挑衅","note":"死对头又来找抽"},"aftermath":"圈子里都在讨论今天的冲突。","scene":"引擎的轰鸣声在休息室外嚣张地响起，贺准推开VIP室的玻璃门，嘴角挂着挑衅的笑。“陆二少，这国庆假期的赛道保养得不行啊，跑起来软绵绵的。”他身后的几个跟班发出哄笑。陆延正靠在沙发上回消息，闻言连眼皮都没抬，只是修长的手指在屏幕上敲击完最后一下，才慢条斯理地将手机倒扣在桌面上。“嫌软？那是你车技太菜，腿软了吧。”陆延站起身，极具侵略性的身高瞬间在气势上压倒了对方，桃花眼里没有一丝笑意。","choices":[{"label":"下场教训他","outcome":"陆延直接换上赛车服，在赛道上用绝对的实力碾压了贺准，让他灰溜溜地离开。","aftermath":"贺准近期不敢再来挑事。","nextDay":null},{"label":"让保安赶人","outcome":"陆延懒得搭理，直接叫安保人员以“非会员禁止入内”为由把贺准一行人请了出去。","aftermath":"贺准在圈子里到处说陆延怂了。","nextDay":null},{"label":"提高场地费","outcome":"陆延冷笑着让经理把贺准等人的场地费翻了三倍，当作“特殊服务费”狠狠宰了一笔。","aftermath":"俱乐部意外小赚一笔。","nextDay":null}],"tellUser":"yes","used":false},{"id":"inc_1791256922281_1","tier":2,"category":"family","valence":"bad","requires":{"start":1080,"end":1320,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":25,"headline":"陆泽的“问候”电话","narration":"陆泽打来电话，语气平淡地通知陆延假期结束后必须回老宅参加家族晚宴。他顺便冷言冷语地敲打了几句关于俱乐部“不务正业”的营收问题。","effect":{"busyLevel":"light","titleOverride":"应付完美哥哥","note":"烦人的说教"},"aftermath":"陆延心情极度烦躁，迫切需要安慰。","scene":"手机屏幕上闪烁着“陆泽”两个字，像是一道催命符。陆延烦躁地抓了抓头发，按下接听键。“假期结束了，明晚回老宅吃饭，别让我派人去绑你。”陆泽的声音永远是那种高高在上的平稳。陆延冷笑一声，靠在车门上点燃了一根烟，“陆总这么闲？俱乐部的营收不用您操心，饿不死我。”电话那头沉默了两秒，随即挂断。陆延吐出一口烟圈，眼神里满是厌恶，只有想到某个小祖宗时，心底的火气才勉强压下几分。","choices":[{"label":"敷衍答应","outcome":"陆延随口“嗯”了一声挂断电话，打算明晚随便找个借口溜走。","aftermath":"明晚可能又要和家里起冲突。","nextDay":null},{"label":"直接拒绝","outcome":"陆延毫不客气地回绝了晚宴邀请，并把手机直接关机。","aftermath":"陆泽可能会派人直接来俱乐部堵他。","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791256922281_2","tier":1,"category":"luck","valence":"good","requires":{"start":720,"end":1080,"busyLevel":["free","light"],"locationKind":"outdoor","weather":[]},"weight":20,"headline":"偶遇绝版盲盒","narration":"陆延在路过一家潮玩店时，意外发现橱窗里摆着一个绝版的小狗造型盲盒。他立刻买了下来，觉得这只小狗摇尾巴的样子特别像自己。","effect":{"busyLevel":"free","titleOverride":"买绝版盲盒","note":"送给小祖宗"},"aftermath":"准备下次见面献宝一样送给ticiy。","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791256922281_3","tier":1,"category":"mishap","valence":"bad","requires":{"start":480,"end":720,"busyLevel":["free","light","busy"],"locationKind":"commute","weather":[]},"weight":20,"headline":"限量跑车被剐蹭","narration":"陆延开着新提的限量版跑车去俱乐部，在路口被一辆违规变道的新手车轻微剐蹭了前保险杠。","effect":{"busyLevel":"busy","titleOverride":"处理交通事故","note":"心疼我的车"},"aftermath":"跑车被送去保养，这几天只能开备用车。","scene":"","choices":[],"tellUser":"yes","used":false}],"lastRollKey":null,"lastTickVts":1791257400733,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"true"},{"userId":"uid_1790097193431_hsqqph93y","key":"customHolidays","value":{}},{"userId":"uid_1790097193431_hsqqph93y","key":"enabledCountries","value":["CN"]},{"userId":"uid_1790097193431_hsqqph93y","key":"events","value":[{"id":1791004174759,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"看看我的小祖宗睡了没","date":"2026-10-04","startTime":"23:00","endTime":"23:59","icon":"📱","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor