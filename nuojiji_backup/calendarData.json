emplate_user_uid_1790097193431_hsqqph93y","value":""},{"userId":"__global__","key":"incident_pool_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":{"generatedAt":1791044613932,"userId":"uid_1790097193431_hsqqph93y","startDateKey":"2026-10-05","days":1,"items":[{"id":"inc_1791044613929_0","tier":1,"category":"luck","valence":"good","requires":{"start":540,"end":720,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":30,"headline":"抢到绝版潮鞋","narration":"陆延常逛的买手店突然上架了一双他盯了很久的限量版联名球鞋。他手速极快地付了定金，心情大好地哼起了歌。","effect":{"busyLevel":"free","titleOverride":"欣赏新鞋订单","note":"运气爆棚"},"aftermath":"等鞋到了穿去给ticiy炫耀","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791044613929_1","tier":2,"category":"family","valence":"bad","requires":{"start":840,"end":1020,"busyLevel":["busy","light"],"locationKind":"work","weather":[]},"weight":30,"headline":"陆泽的“突击检查”","narration":"陆泽突然出现在超跑俱乐部，一身剪裁得体的定制西装与周围充满轮胎焦糊味和引擎轰鸣声的赛道格格不入。他是来提醒陆延参加下周的家族商业晚宴的。","effect":{"busyLevel":"busy","titleOverride":"应付亲哥","note":"烦人的说教时间"},"aftermath":"心情烦躁，急需在赛道上飙两圈发泄","scene":"引擎的轰鸣声中，陆延刚摘下头盔，就看到看台边缘站着个熟悉的身影。陆泽穿着一丝不苟的三件套西服，手里甚至还拿着把黑色的长柄伞，像个刚从华尔街开完会的AI机器人。周围的赛车手们都不自觉地放低了声音。陆泽推了推金丝眼镜，语气平静：“下周五晚上的慈善晚宴，父亲让你务必出席，别再穿那些破洞的衣服。”陆延甩了甩被汗水打湿的浅金色头发，冷笑了一声，把头盔随手扔给技师：“我的事，用不着你管。”","choices":[{"label":"直接嘲讽送客","outcome":"陆延毫不客气地用几句夹枪带棒的话把陆泽怼了回去，转身就走，留下陆泽在原地皱眉。","aftermath":"兄弟俩的关系再次降至冰点","nextDay":null},{"label":"敷衍答应了事","outcome":"为了赶紧让这个“西装怪”消失在自己的地盘，陆延不耐烦地摆摆手表示知道了，把人迅速打发走。","aftermath":"下周五的日程被迫加上了无聊的晚宴","nextDay":null}],"tellUser":"yes","used":false},{"id":"inc_1791044613929_2","tier":2,"category":"work","valence":"neutral","requires":{"start":840,"end":1080,"busyLevel":["busy"],"locationKind":"work","weather":[]},"weight":30,"headline":"业余车手撞车事故","narration":"国庆杯挑战赛上，一名业余车手入弯时错估了刹车点，一头扎进了轮胎墙。虽然人没事，但那台保时捷的前保险杠彻底报废，现场需要紧急处理。","effect":{"busyLevel":"busy","titleOverride":"处理撞车事故","note":"清理赛道碎片"},"aftermath":"俱乐部赛道短暂封闭了一小时进行清理","scene":"刺耳的刹车声后是一声沉闷的巨响。一辆银色的保时捷911在三号弯失控，直接吻上了红白相间的轮胎墙。碳纤维碎片碎了一地，引擎盖冒出阵阵白烟。陆延皱了皱眉，立刻抓起对讲机：“红旗！所有车辆减速回维修区！医疗车和清障车马上过去！”他大步流星地走向事故现场，看着那个从驾驶座里爬出来、脸色惨白直发抖的年轻车手，无奈地叹了口气。人没事就行，车撞了那是钱的事。","choices":[{"label":"亲自下场示范","outcome":"处理完事故后，陆延换上赛车服，开着自己的战车在赛道上跑了一圈完美走线，教那群菜鸟什么叫真正的过弯。","aftermath":"收获了全场迷弟迷妹的尖叫","nextDay":null},{"label":"按流程走保险","outcome":"陆延把后续的定损和保险理赔工作直接丢给了俱乐部的经理，自己回休息室喝冰水降火去了。","aftermath":"经理加班处理了一堆繁琐的文件","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791044613929_3","tier":3,"category":"social","valence":"bad","requires":{"start":1200,"end":1380,"busyLevel":["light","free"],"locationKind":"social","weather":[]},"weight":20,"headline":"贺准带人砸场子","narration":"死对头贺准带着几个狐朋狗友突然出现在俱乐部的Lounge，不仅大声喧哗，还试图用高额赌注挑衅俱乐部的常驻车手，场面一度非常难看。","effect":{"busyLevel":"busy","titleOverride":"处理贺准挑衅","note":"死对头又来找抽"},"aftermath":"和贺准的梁子结得更深了","scene":"Lounge里的音乐声被一阵突兀的哄笑打断。贺准大喇喇地靠在吧台上，手里晃着一杯威士忌，指着墙上陆延的冠军海报大声嘲笑：“就这破成绩，也好意思挂在最显眼的地方？你们这儿的车手是不是都没见过世面？”几个俱乐部的会员已经气得站了起来，气氛剑拔弩张。陆延分开人群走上前，嘴角勾起一抹极冷的笑意，左耳的碎钻耳钉在昏暗的灯光下闪过一丝寒芒：“贺准，你是不是嫌上次输给我以后，脸丢得还不够大？”","choices":[{"label":"赛道上见真章","outcome":"陆延直接把车钥匙拍在桌上，逼贺准签了生死状，两人在深夜的赛道上跑了一场极速对决，贺准惨败离场。","aftermath":"贺准颜面扫地，短期内不敢再来挑衅","nextDay":{"title":"检查赛车磨损","busyLevel":"busy","span":"morning"}},{"label":"让保安直接轰人","outcome":"陆延觉得跟这种人多说一句话都是浪费时间，直接打了个响指，让几个身材魁梧的保安把贺准一行人“请”了出去。","aftermath":"贺准在门外骂骂咧咧，扬言要报复","nextDay":null},{"label":"嘴炮嘲讽破防","outcome":"陆延发挥了自己毒舌的功力，三言两语把贺准最近几场比赛的拉胯表现扒了个底朝天，气得贺准摔杯子走人。","aftermath":"俱乐部会员爆发出一阵欢呼，气氛更热烈了","nextDay":null}],"tellUser":"yes","used":false}],"lastRollKey":null,"lastTickVts":1791128956460,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","va