dueDate":"2026-10-05","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791414135389,"autoCompletedAt":1791414135389},{"id":1791044633939,"text":"给ticiy搜罗那个绝版的Molly盲盒","completed":true,"dueDate":"2026-10-05","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791414135389,"autoCompletedAt":1791414135389},{"id":1791003694757,"text":"把拉法送去保养","completed":true,"dueDate":"2026-10-04","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791162131640,"autoCompletedAt":1791162131640}]},{"userId":"__global__","key":"core_4102444800000_enabled","value":"false"},{"userId":"__global__","key":"core_4102444800000_entries","value":[]},{"userId":"__global__","key":"core_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"false"},{"userId":"__global__","key":"core_42e461eb-9415-4abe-8c47-ecfdaccd5458_entries","value":[]},{"userId":"__global__","key":"gen_template_4102444800000","value":""},{"userId":"__global__","key":"gen_template_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":""},{"userId":"__global__","key":"gen_template_user_uid_1790097193431_hsqqph93y","value":""},{"userId":"__global__","key":"incident_pool_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":{"generatedAt":1791760325126,"userId":"uid_1790097193431_hsqqph93y","startDateKey":"2026-10-13","days":1,"items":[{"id":"inc_1791760325123_0","tier":1,"category":"mishap","valence":"bad","requires":{"start":840,"end":1080,"busyLevel":["free","light","busy"],"locationKind":"work","weather":[]},"weight":25,"headline":"限量版卫衣沾到机油","narration":"陆延在车库检查赛车底盘时，不慎蹭到了一块未清理干净的机油。限量版卫衣的袖口立刻染上了一块明显的污渍。他烦躁地啧了一声，脱下外套扔给了一旁的助理去处理。","effect":{"busyLevel":"light","titleOverride":"换下脏衣服","note":"心疼限量款三秒"},"aftermath":"","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791760325123_1","tier":2,"category":"family","valence":"bad","requires":{"start":660,"end":840,"busyLevel":["light","free"],"locationKind":"social","weather":[]},"weight":30,"headline":"偶遇完美老哥陆泽","narration":"午餐时间，陆延在常去的西餐厅意外撞见了正在进行商务会谈的哥哥陆泽。陆泽西装革履，皱着眉看了一眼陆延略显随意的穿着，场面瞬间冷了下来。陆泽似乎想说教两句，陆延则翻了个白眼准备离开。","effect":{"busyLevel":"light","titleOverride":"被迫听老哥说教","note":"心情瞬间烦躁"},"aftermath":"被败了兴致，晚上更需要小祖宗的顺毛安慰。","scene":"餐厅柔和的古典乐中，兄弟俩的对峙显得格格不入。陆泽放下手中的咖啡杯，目光扫过陆延领口大开的夹克：“你这身打扮，又是刚从哪个赛车场混完回来？家里下午有个会，你最好出席一下。”陆延冷笑一声，双手插兜，身体微微后仰：“陆大总裁，您日理万机就别管我这个闲人了，那破会谁爱去谁去。”","choices":[{"label":"直接走人","outcome":"陆延懒得理会，比了个中指直接转身离开餐厅，留陆泽在原地皱眉。","aftermath":"逃避了家族会议，心情稍有好转。","nextDay":null},{"label":"阴阳怪气","outcome":"陆延笑着嘲讽了几句陆泽的无趣人生，随后心情大好地去结账走人。","aftermath":"成功气到老哥，打算把这事当笑话讲给她听。","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791760325123_2","tier":2,"category":"luck","valence":"good","requires":{"start":600,"end":1200,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":30,"headline":"绝版头盔现世","narration":"陆延收到圈内好友的消息，之前一直苦寻无果的一款绝版签名赛车头盔，有藏家愿意出手。对方开价极高，但要求今天之内必须决定。这可是他心心念念了半年的宝贝。","effect":{"busyLevel":"light","titleOverride":"联络藏家买头盔","note":"钱不是问题"},"aftermath":"成功拿下头盔，准备下次见面时献宝。","scene":"休息室里，手机屏幕上显示着那顶红黑涂装的绝版头盔照片。陆延的眼睛瞬间亮了起来，连呼吸都急促了几分。他立刻拨通了那个藏家的电话，手指在桌面上兴奋地敲击着。“价格随你开，东西我要了，现在就派人去拿。”他语气中满是势在必得的兴奋，脑子里已经开始盘算着怎么向她炫耀这件新战利品了。","choices":[{"label":"毫不犹豫拿下","outcome":"陆延直接转账，连价都没还，生怕对方反悔。","aftermath":"账户余额减少，但获得了极大的心理满足。","nextDay":null},{"label":"拉江驰去验货","outcome":"陆延一个电话把江驰叫来，让他陪着去现场仔细检查头盔的品相。","aftermath":"江驰被迫充当免费鉴定师，陆延成功入手。","nextDay":null}],"tellUser":"yes","used":false},{"id":"inc_1791760325123_3","tier":2,"category":"mishap","valence":"bad","requires":{"start":840,"end":1080,"busyLevel":["busy"],"locationKind":"outdoor","weather":[]},"weight":20,"headline":"赛道测试突发爆胎","narration":"下午的GT3赛道全速测试中，赛车在过弯时右后轮突然爆胎。凭借着极高的职业素养，陆延迅速稳住方向盘，将赛车安全停在缓冲带。虽然人没事，但后续的测试计划被迫中断。","effect":{"busyLevel":"busy","titleOverride":"处理爆胎事故","note":"惊险一刻"},"aftermath":"赛车送修，晚上急需抱着小祖宗压惊。","scene":"刺耳的轮胎摩擦声划破了赛车场的宁静。陆延在车内感受到剧烈的震动，肾上腺素瞬间飙升，双手死死控住方向盘，硬生生将失控的赛车拽回了安全线。摘下头盔时，他的额头布满了一层薄汗，心跳如擂鼓。看着冒烟的轮胎，他长舒了一口气，第一反应竟然是摸出手机想听听那个熟悉的声音。","choices":[{"label":"立刻求安慰","outcome":"陆延立刻给心上人发去消息，疯狂撒娇卖惨，试图骗取亲亲抱抱。","aftermath":"成功获得心上人的心疼与加倍宠爱。","nextDay":null},{"label":"自己默默消化","outcome":"陆延不想让她担心，一个人坐在维修区抽了根烟，平复心情后才离开。","aftermath":"对赛车的安全性提出了更严苛的要求。","nextDay":null}],"tellUser":"yes","used":false}],"lastRollKey":null,"lastTickVts":1791807458065,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"owner_migrated_v1","value":true},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"true"},{"userId":"uid_1790097193431_hsqqph93y","key":"customHolidays","value":{}},{"userId":"uid_1790097193431_hsqqph93y","key":"enabledCountries","value":["CN"]},{"userId":"uid_1790097193431_hsqqph93y","key":"events","value":[{"id":1791004174759,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"看看我的小祖宗睡了没","date":"2026-10-04","startTime":"23:00","endTime":"23:59","icon":"📱","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098006,"title":"接小祖宗吃晚饭","location":"私房菜馆","note":"带上昨天排队买的限量草莓蛋糕","date":"2026-10-06","startTime":"18:00","endTime":"20:30","icon":"🍓","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098007,"title":"送她回家赖着不走","location":"t