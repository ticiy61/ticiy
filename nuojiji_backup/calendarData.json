:1791414135389},{"id":1791003694757,"text":"把拉法送去保养","completed":true,"dueDate":"2026-10-04","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791162131640,"autoCompletedAt":1791162131640}]},{"userId":"__global__","key":"core_4102444800000_enabled","value":"false"},{"userId":"__global__","key":"core_4102444800000_entries","value":[]},{"userId":"__global__","key":"core_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"false"},{"userId":"__global__","key":"core_42e461eb-9415-4abe-8c47-ecfdaccd5458_entries","value":[]},{"userId":"__global__","key":"gen_template_4102444800000","value":""},{"userId":"__global__","key":"gen_template_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":""},{"userId":"__global__","key":"gen_template_user_uid_1790097193431_hsqqph93y","value":""},{"userId":"__global__","key":"incident_pool_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":{"generatedAt":1791932442851,"userId":"uid_1790097193431_hsqqph93y","startDateKey":"2026-10-15","days":1,"items":[{"id":"inc_1791932442850_0","tier":1,"category":"luck","valence":"good","requires":{"start":960,"end":1110,"busyLevel":["free","light"],"locationKind":"outdoor","weather":[]},"weight":30,"headline":"抢到最后一份蛋糕","narration":"陆延路过网红甜品店时，正好遇到店里最后一批限量版草莓熔岩蛋糕出炉。他毫不犹豫地包下了最后两个，准备晚上拿去邀功。","effect":{"busyLevel":"light","titleOverride":"买草莓蛋糕","note":"开心得像中了大奖"},"aftermath":"晚上成功用蛋糕换到了亲亲","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791932442850_1","tier":2,"category":"work","valence":"bad","requires":{"start":780,"end":1020,"busyLevel":["busy"],"locationKind":"work","weather":[]},"weight":25,"headline":"模拟器数据异常","narration":"下午在俱乐部进行GT3模拟器测试时，系统突然报错，显示转向过载数据异常。技术团队不得不暂停测试，重新排查传感器的连接线路。","effect":{"busyLevel":"busy","titleOverride":"排查模拟器故障","note":"烦躁得想骂人"},"aftermath":"耽误了半小时的测试进度","scene":"屏幕上的虚拟赛道突然卡顿，紧接着刺耳的警报声在空旷的模拟室里响起。陆延皱着眉摘下VR头盔，随手抓了把被汗水浸湿的头发。“怎么回事？转向阻尼的手感完全不对。”他从模拟舱里跨出来，看了一眼旁边满头大汗的工程师。技术主管赶紧凑上前解释是传感器接口松动。陆延烦躁地啧了一声，靠在舱门上点开手机，“赶紧修，我只给你们半小时。”","choices":[{"label":"亲自上手排查","outcome":"陆延懒得等，自己钻进模拟舱底座重新接线，弄得满手油污才搞定。","aftermath":"满手油污洗了好几遍才干净","nextDay":null},{"label":"去旁边抽烟等","outcome":"陆延走到室外抽了根烟，顺便给江驰发消息吐槽技术团队的效率。","aftermath":"连发了十几条消息轰炸江驰","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791932442850_2","tier":2,"category":"social","valence":"neutral","requires":{"start":660,"end":840,"busyLevel":["free","light","busy"],"locationKind":"any","weather":[]},"weight":20,"headline":"偶遇完美老哥","narration":"在商务区吃午饭时，陆延隔着玻璃窗看到了刚从高级黑色轿车里下来的陆泽。对方西装革履，正被一群高管簇拥着走向对面的写字楼。","effect":{"busyLevel":"light","titleOverride":"盯着窗外翻白眼","note":"看见亲哥就倒胃口"},"aftermath":"","scene":"餐厅的冷气开得很足，陆延正百无聊赖地搅动着杯子里的冰块。余光瞥见街对面那抹熟悉的、一丝不苟的灰色西装时，他的动作顿住了。陆泽依旧是那副完美无缺的精英做派，连头发丝的弧度都挑不出毛病。隔着一条街的车水马龙，陆泽似乎察觉到了视线，微微偏头看了过来。两人的目光在半空中交汇了一秒，陆延嗤笑一声，率先移开视线，端起冰水一饮而尽。","choices":[{"label":"假装没看见","outcome":"陆延低头继续看手机，权当那群人是空气，连打招呼的表面功夫都懒得做。","aftermath":"心情莫名烦躁了一下午","nextDay":null},{"label":"隔窗举杯挑衅","outcome":"陆延懒洋洋地靠在椅背上，冲着窗外举了举手里的玻璃杯，嘴角勾起一抹挑衅的笑。","aftermath":"收到了陆泽发来的说教短信，直接无视","nextDay":null}],"tellUser":"no","used":false},{"id":"inc_1791932442850_3","tier":3,"category":"mishap","valence":"bad","requires":{"start":900,"end":1200,"busyLevel":["busy","light"],"locationKind":"work","weather":[]},"weight":15,"headline":"暴发户客户闹事","narration":"超跑俱乐部大厅来了一位喝多了的富二代客户，因为没有预约被拒而大发雷霆，甚至推搡了前台的员工。陆延接到苏柚的电话后脸色阴沉地赶回了大厅。","effect":{"busyLevel":"busy","titleOverride":"处理闹事客户","note":"眼神冷得想杀人"},"aftermath":"直接把该客户拉入了俱乐部永久黑名单","scene":"俱乐部的VIP休息区一片狼藉，昂贵的骨瓷茶杯碎了一地。满身酒气的年轻男人正指着苏柚的鼻子破口大骂。陆延沉着脸大步流星地走过去，一把攥住那人挥舞的手腕，力道大得几乎能听到骨骼错位的声音。“在我陆延的地盘上撒野，你算什么东西？”他眼神冷得像结了冰，周身那股不学无术的浪荡劲儿瞬间收敛，取而代之的是极具压迫感的狠戾。那人被震得酒醒了大半，对上陆延的视线时，腿肚子竟有些发软。","choices":[{"label":"直接动手扔出去","outcome":"陆延毫不客气地一脚踹在对方膝弯，直接让保安把这个软骨头丢出了俱乐部大门。","aftermath":"圈内传遍了陆二少不好惹的名声","nextDay":{"title":"处理后续投诉","busyLevel":"busy","span":"morning"}},{"label":"强压怒火冷处理","outcome":"顾及俱乐部的声誉，陆延捏着对方手腕逼他给前台道了歉，随后直接拉黑了这人的所有权限。","aftermath":"给受惊的员工发了双倍奖金压惊","nextDay":null}],"tellUser":"maybe","used":false}],"lastRollKey":null,"lastTickVts":1791970107801,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"owner_migrated_v1","value":true},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"true"},{"userId":"uid_1790097193431_hsqqph93y","key":"customHolidays","value":{}},{"userId":"uid_1790097193431_hsqqph93y","key":"enabledCountries","value":["CN"]},{"userId":"uid_1790097193431_hsqqph93y","key":"events","value":[{"id":1791004174759,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"看看我的小祖宗睡了没","date":"2026-10-04","startTime":"23:00","endTime":"23:59","icon":"📱","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098006,"title":"接小祖宗吃晚饭","location":"私房菜馆","note":"带上昨天排队买的限量草莓蛋糕","date":"2026-10-06","startTime":"18:00","endTime":"20:30","icon":"🍓","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098007,"title":"送她回家赖着不走","location":"ticiy家楼下","note":"明明知道密码0562，偏要等她开门","date":"2026-10-06","startTime":"21:00","endTime":"22:00","icon":"🐶","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098008,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"刚洗完澡，头发半干，疯狂求夸奖","date":"2026-10-06","startTime":"23:00","endTime":"23:59","icon":"🌙","type":"user","characterId":"42e46