Level":["free","light"],"locationKind":"social","weather":[]},"weight":30,"headline":"餐厅偶遇陆泽","narration":"陆延在常去的西餐厅吃饭时，意外碰到了刚结束商务会谈的亲哥陆泽。陆泽一身高定西装，皱着眉对陆延的着装和近期行踪进行了几句说教。陆延敷衍地应付了两句，连饭都没吃完就找借口溜了。","effect":{"busyLevel":"light","titleOverride":"听亲哥念经","note":"烦躁值直线上升"},"aftermath":"拉黑了陆泽的号码一天以示抗议。","scene":"餐厅的冷气开得很足。陆延正低头给手机里置顶的人发着小狗表情包，余光就瞥见了一道极具压迫感的身影。陆泽穿着一丝不苟的三件套西装，停在他的桌边，金丝眼镜后的目光带着审视：“听说你最近连家都不回，整天泡在那个赛车场里？”陆延嘴角的笑意瞬间收敛，将手机往桌上一扣，懒洋洋地往椅背上一靠：“陆大总裁百忙之中还有空关心我这闲人？赛车场挺好，至少没人天天在我耳边念经。”陆泽眉头微皱，似乎还想说什么，陆延已经站起身，捞起车钥匙：“单我买了，哥你慢慢吃。”","choices":[{"label":"强行拉黑","outcome":"陆延烦躁地走出门，直接把陆泽的号码设了免打扰，转头去赛车场跑了二十圈发泄。","aftermath":"手机里清净了一整天。","nextDay":null},{"label":"发消息求安慰","outcome":"陆延坐在跑车里没急着发动，而是拍了张自己委屈巴巴的照片发给心上人，控诉亲哥的无趣。","aftermath":"心情因为收到的回复瞬间多云转晴。","nextDay":null}],"tellUser":"yes","used":false},{"id":"inc_1791413527007_1","tier":2,"category":"work","valence":"neutral","requires":{"start":840,"end":1080,"busyLevel":["busy","free"],"locationKind":"work","weather":[]},"weight":30,"headline":"俱乐部突发纠纷","narration":"俱乐部里一个刚入会的新人仗着家里有钱，违规操作导致赛车受损，不仅不认账还大声嚷嚷。陆延被经理请去处理，面对对方的嚣张态度，他直接冷着脸把人连车带卡扔出了俱乐部。","effect":{"busyLevel":"busy","titleOverride":"处理违规会员","note":"气场全开，冷脸训人"},"aftermath":"安排技师对受损的赛道设施进行抢修。","scene":"俱乐部的VIP车库里回荡着刺耳的争吵声。一个染着黄毛的年轻富二代正指着引擎盖上冒烟的跑车破口大骂，坚称是俱乐部的保养有问题。陆延单手插兜走过去，眼神冷得像冰：“调监控了吗？”经理擦着汗点头。陆延瞥了一眼监控画面里对方明显的违规弹射起步，嗤笑了一声。他走到黄毛面前，187的身高带着极强的压迫感：“规矩写得很清楚，不识字就回小学重读。你的会籍取消了，带着你的破车滚出去。”黄毛被他的气场震住，一时竟不敢再出声。","choices":[{"label":"亲自盯场检修","outcome":"虽然把人赶走了，但看着受损的赛道设施，陆延还是亲自动手带着技师修补了一下午。","aftermath":"身上沾了些机油味，洗了好几遍澡。","nextDay":null},{"label":"去酒吧区喝冰水","outcome":"陆延嫌麻烦，把后续烂摊子丢给经理，自己跑去俱乐部的Lounge倒了杯冰水降火。","aftermath":"给经理发了一个大红包当精神损失费。","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791413527007_2","tier":1,"category":"luck","valence":"good","requires":{"start":960,"end":1140,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":20,"headline":"抢到限量草莓大福","narration":"陆延路过一家网红甜品店，刚好遇到最后一份季节限定的草莓大福出炉。他毫不犹豫地买下，准备晚上拿去献宝。","effect":{"busyLevel":"free","titleOverride":"排队买甜品","note":"心情大好"},"aftermath":"","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791413527007_3","tier":1,"category":"mishap","valence":"bad","requires":{"start":540,"end":1200,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":20,"headline":"限量球鞋被踩","narration":"在俱乐部巡视时，陆延刚上脚的限量版球鞋被粗心的学徒不小心踩了一脚。看着那个战战兢兢的学徒，他无奈地挥挥手没计较。","effect":{"busyLevel":"free","titleOverride":"心痛擦鞋","note":"新鞋首穿就破功"},"aftermath":"","scene":"","choices":[],"tellUser":"maybe","used":false}],"lastRollKey":null,"lastTickVts":1791451479689,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"true"},{"userId":"uid_1790097193431_hsqqph93y","key":"customHolidays","value":{}},{"userId":"uid_1790097193431_hsqqph93y","key":"enabledCountries","value":["CN"]},{"userId":"uid_1790097193431_hsqqph93y","key":"events","value":[{"id":1791004174759,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"看看我的小祖宗睡了没","date":"2026-10-04","startTime":"23:00","endTime":"23:59","icon":"📱","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098006,"title":"接小祖宗吃晚饭","location":"私房菜馆","note":"带上昨天排队买的限量草莓蛋糕","date":"2026-10-06","startTime":"18:00","endTime":"20:30","icon":"🍓","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098007,"title":"送她回家赖着不走","location":"ticiy家楼下","note":"明明知道密码0562，偏要等她开门","date"