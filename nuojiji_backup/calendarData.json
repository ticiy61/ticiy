r","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791414135389,"autoCompletedAt":1791414135389},{"id":1791044633938,"text":"联系设计师确认下个月的头盔定制涂装","completed":true,"dueDate":"2026-10-05","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791414135389,"autoCompletedAt":1791414135389},{"id":1791044633939,"text":"给ticiy搜罗那个绝版的Molly盲盒","completed":true,"dueDate":"2026-10-05","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791414135389,"autoCompletedAt":1791414135389},{"id":1791003694757,"text":"把拉法送去保养","completed":true,"dueDate":"2026-10-04","ownerId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","ownerType":"character","supervisor":"陆延","supervisorId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","isAI":true,"completedAt":1791162131640,"autoCompletedAt":1791162131640}]},{"userId":"__global__","key":"core_4102444800000_enabled","value":"false"},{"userId":"__global__","key":"core_4102444800000_entries","value":[]},{"userId":"__global__","key":"core_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"false"},{"userId":"__global__","key":"core_42e461eb-9415-4abe-8c47-ecfdaccd5458_entries","value":[]},{"userId":"__global__","key":"gen_template_4102444800000","value":""},{"userId":"__global__","key":"gen_template_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":""},{"userId":"__global__","key":"gen_template_user_uid_1790097193431_hsqqph93y","value":""},{"userId":"__global__","key":"incident_pool_42e461eb-9415-4abe-8c47-ecfdaccd5458","value":{"generatedAt":1791628034169,"userId":"uid_1790097193431_hsqqph93y","startDateKey":"2026-10-11","days":1,"items":[{"id":"inc_1791628034167_0","tier":1,"category":"luck","valence":"good","requires":{"start":780,"end":1080,"busyLevel":["free","light","busy"],"locationKind":"any","weather":[]},"weight":25,"headline":"抢到限量版盲盒","narration":"陆延托朋友在海外代购的限量版潮玩终于到货了。他第一时间拆开检查，确认没有任何瑕疵后，小心翼翼地放进副驾驶的专属储物格里。","effect":{"busyLevel":"free","titleOverride":"把玩新潮玩","note":"准备给小祖宗一个惊喜"},"aftermath":"满心欢喜地计划着送礼物时的说辞","scene":"","choices":[],"tellUser":"yes","used":false},{"id":"inc_1791628034167_1","tier":2,"category":"social","valence":"bad","requires":{"start":840,"end":1020,"busyLevel":["busy","light"],"locationKind":"work","weather":[]},"weight":30,"headline":"赛道偶遇死对头","narration":"周末的赛道日异常热闹，陆延正准备下场跑两圈，却在维修区碰见了带着车队来试车的贺准。两人视线交汇，空气中顿时充满火药味。贺准出言挑衅，陆延冷笑一声，直接戴上头盔用圈速说话。","effect":{"busyLevel":"busy","titleOverride":"赛道疯狂飙车","note":"满眼桀骜，准备教训死对头"},"aftermath":"心情略显暴躁，需要小祖宗顺毛","scene":"引擎的轰鸣声在维修区回荡。贺准靠在改装过的GTR旁，似笑非笑地看着走来的陆延：“陆二少，今天又来过家家？”陆延脚步微顿，嘴角勾起一抹桀骜的弧度。他单手转着头盔，眼神冷得像冰：“过家家也能套你圈，不服下场试试？”周围的空气瞬间降至冰点，两人的车队成员面面相觑。陆延懒得废话，直接拉开车门坐进驾驶座，轰下一脚油门，排气管喷出嚣张的蓝色尾焰。","choices":[{"label":"赛道绝对碾压","outcome":"陆延在赛道上以绝对优势刷新了贺准的圈速记录，下车后嚣张地比了个倒竖的大拇指。","aftermath":"得意洋洋，迫不及待想向ticiy炫耀战绩","nextDay":null},{"label":"无视无聊挑衅","outcome":"陆延觉得为了这种人浪费轮胎不值，冷笑一声后直接转身回了VIP休息室，连个眼神都没多给。","aftermath":"提前结束了赛道活动，去找江驰吐槽","nextDay":null}],"tellUser":"yes","used":false},{"id":"inc_1791628034167_2","tier":2,"category":"family","valence":"bad","requires":{"start":960,"end":1140,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":20,"headline":"陆泽的突击检查","narration":"陆泽突然出现在俱乐部，以家族名义要求陆延今晚回老家参加长辈的晚宴。陆延极度抗拒，两人在办公室里爆发了短暂的争吵。最终陆延为了不让对方继续干涉自己的俱乐部，只能黑着脸妥协。","effect":{"busyLevel":"busy","titleOverride":"被迫参加家族晚宴","note":"浑身散发着生人勿近的低气压"},"aftermath":"晚宴后心情极差，极度渴望见到ticiy","scene":"俱乐部二楼的VIP室门被推开，陆泽一身笔挺的定制西装，与周围喧闹的环境格格不入。他推了推金丝眼镜，语气平淡却不容置疑：“今晚爷爷大寿，你必须出席。”陆延正咬着一根草莓味棒棒糖，闻言嗤笑一声，把糖骨碌碌转到左边腮帮子：“我不去，你们一家人其乐融融不挺好？”陆泽皱起眉头，上前一步压低声音：“陆延，别闹了，别让妈难堪。”陆延眼底的笑意瞬间褪去，沉默半晌后，烦躁地把棒棒糖扔进垃圾桶。","choices":[{"label":"冷脸妥协赴宴","outcome":"陆延换上极其不合身的西装，全程冷脸参加了晚宴，一句话都没多说，只顾着在桌下偷偷给ticiy发消息。","aftermath":"晚上疯狂缠着ticiy求安慰，像只受委屈的大狗","nextDay":{"title":"心情低落求顺毛","busyLevel":"light","span":"morning"}},{"label":"找借口翻墙溜走","outcome":"陆延在晚宴进行到一半时，借口俱乐部有紧急事故，翻墙溜出了老宅，开着跑车扬长而去。","aftermath":"虽然逃出来了，但心里还是有些烦闷","nextDay":null}],"tellUser":"maybe","used":false},{"id":"inc_1791628034167_3","tier":1,"category":"mishap","valence":"neutral","requires":{"start":540,"end":840,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":25,"headline":"找不到打火机","narration":"陆延摸遍了浑身上下的口袋，都没找到那个常用的定制防风打火机。他烦躁地抓了抓头发，怀疑是昨天落在江驰的车上了。","effect":{"busyLevel":"free","titleOverride":"翻箱倒柜找东西","note":"莫名烦躁，想咬点什么"},"aftermath":"发微信轰炸江驰，让他赶紧把打火机送过来","scene":"","choices":[],"tellUser":"no","used":false}],"lastRollKey":null,"lastTickVts":1791648946708,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":true,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{}}},{"userId":"__global__","key":"schedule_invite_42e461eb-9415-4abe-8c47-ecfdaccd5458_enabled","value":"true"},{"userId":"uid_1790097193431_hsqqph93y","key":"customHolidays","value":{}},{"userId":"uid_1790097193431_hsqqph93y","key":"enabledCountries","value":["CN"]},{"userId":"uid_1790097193431_hsqqph93y","key":"events","value":[{"id":1791004174759,"title":"睡前视频连麦","location":"独栋别墅卧室","note":"看看我的小祖宗睡了没","date":"2026-10-04","startTime":"23:00","endTime":"23:59","icon":"📱","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098006,"title":"接小祖宗吃晚饭","location":"私房菜馆","note":"带上昨天排队买的限量草莓蛋糕","date":"2026-10-06","startTime":"18:00","endTime":"20:30","icon":"🍓","type":"user","characterId":"42e461eb-9415-4abe-8c47-ecfdaccd5458","characterName":"陆延","bgColor":"#FCE4EC","accentColor":"#F48FB1","fromScheduleInvite":true},{"id":1791133098007,"title":"送她回家赖着不走","